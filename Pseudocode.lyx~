\series medium
\shape up
\size normal
\emph off
\nospellcheck off
\bar no
\strikeout off
\xout off
\uuline off
\uwave off
\noun off
\color none
\begin_inset Formula $\tilde{\rho}(s,\pi,m|\tilde{\eta})$
\end_inset

:
 The physiological state distribution of newborn individuals given their evolved prior for the distribution of patch density states 
\begin_inset Formula $\tilde{\eta}$
\end_inset

.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $P(s^{\prime},m^{\prime}|x,s,\pi^{\prime},m,g)$
\end_inset

:
 The physiological state transition probabilities,
 from some state 
\begin_inset Formula $\{s^{\prime},\pi^{\prime},m^{\prime}\}$
\end_inset

 to state 
\begin_inset Formula $\{s,\pi,m\}$
\end_inset

,
 given the resident developmental strategy 
\begin_inset Formula $x(s,\pi,m)$
\end_inset

 and given the risks of death from malnutrition.
\end_layout

\begin_layout Standard
Finally,
 in the first instance,
 there is no evolutionary history from which to derive the prior 
\begin_inset Formula $\tilde{\eta}$
\end_inset

,
 and so we assume (given that we initialise 
\begin_inset Formula $\eta=0.5$
\end_inset

) newborns have an accurate prior for 
\begin_inset Formula 
\begin{equation}
\tilde{\eta}=0.5.\label{eq:-49}
\end{equation}

\end_inset

Once the distribution of newborns is determined initialised as per section 3.2,
 we can then assume that all individuals are newborns in the first time step,
 and so the distribution of physiological states for patches of each density state 
\begin_inset Formula $n\in\{0,1\}$
\end_inset

shall be
\begin_inset Formula 
\[
\rho_{n}(s,\pi,m)=\tilde{\rho}(s,\pi,m)
\]

\end_inset

where 
\begin_inset Formula $\rho_{n}(s,\pi,m)$
\end_inset

 is the proportion of individuals that are of state 
\begin_inset Formula $\{s,\pi,m\}$
\end_inset

given that they are in a patch of population density state 
\begin_inset Formula $n\in\{0,1\}$
\end_inset

.
\end_layout

\begin_layout Standard
Then for the evolve prior for 
\begin_inset Formula $\tilde{P}(q_{n}|q_{o})$
\end_inset

 we assume it is based only on the parametised values for transitions from stochasticity and perturbations and so in the first instance
\begin_inset Formula 
\[
\tilde{P}(q_{n}|q_{o})=P_{stoch}(q_{n}|q_{o}).
\]

\end_inset

As for the initial resident strategy,
 we assume individuals never invest in developing their quality state and so for all states 
\begin_inset Formula 
\[
x(s,\pi,m)=G
\]

\end_inset

where 
\begin_inset Formula $G$
\end_inset

 is the maximum food mass input within a given growth cycle.
\end_layout

\begin_layout Subsection
Development
\end_layout

\begin_layout Standard
Given the baseline rate of death 
\begin_inset Formula $\lambda$
\end_inset

 and deaths caused by lack of investment in maintenance,
 the posterior proportions of each physiological state in sub-populations of each patch state 
\begin_inset Formula $n$
\end_inset

 is 
\begin_inset Formula 
\begin{equation}
\hat{\rho_{n}}(s^{\prime},\pi^{\prime},m^{\prime})=\sum_{g}\sum_{s}\sum_{\pi}\sum_{m}P(s^{\prime},m^{\prime},\text{survives}|s,\pi^{\prime},m,g)\cdot P(\pi^{\prime}|\pi,g)\cdot L(g|q_{n})\cdot\rho_{n}(s,\pi,m)\label{eq:-17}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Where,
 as a reminder,
 
\begin_inset Formula $\rho_{n}(s,\pi,m)$
\end_inset

 is the prior probability distribution over states given the patch is of population size 
\begin_inset Formula $q_{n}$
\end_inset

,
 
\begin_inset Formula $P(g|q_{n})$
\end_inset

 is the probability of a food mass of 
\begin_inset Formula $g$
\end_inset

 in patches of size 
\begin_inset Formula $q_{n}$
\end_inset

,
 
\begin_inset Formula $P(\pi^{\prime}|\pi,g)$
\end_inset

 is the probability of transitioning to posterior information state 
\begin_inset Formula $\pi^{\prime}$
\end_inset

 given this food mass,
 and 
\begin_inset Formula $P(s^{\prime},m^{\prime},\text{survives}|s,\pi^{\prime},m,g)$
\end_inset

 is the probability of them surviving transitioning to size state 
\begin_inset Formula $s^{\prime}$
\end_inset

 and quality state 
\begin_inset Formula $m^{\prime}$
\end_inset

 given the outcomes of development and given that they have survived maintenance costs.
\end_layout

\begin_layout Subsection
Births and deaths
\end_layout

\begin_layout Subsubsection
Birth rates
\end_layout

\begin_layout Standard
Assuming a dispersal rate of 
\begin_inset Formula $\mu$
\end_inset

 and a fixed number of patches 
\begin_inset Formula $N$
\end_inset

,
 the number of individuals arriving in each patch of population density 
\begin_inset Formula $q_{n}$
\end_inset

 is
\begin_inset Formula 
\begin{equation}
\alpha(q_{n})=(1-\mu)\cdot q_{n}\cdot r(q_{n})+\frac{\mu\cdot\cancel{N}\cdot[(1-\eta)\cdot q_{0}\cdot r(q_{0})+\eta\cdot q_{1}\cdot r(q_{1})]}{\cancel{N}}\label{eq:-4}
\end{equation}

\end_inset

where 
\begin_inset Formula $r(q_{n})$
\end_inset

 is the expected reproductive rate of an individual in a patch of population density 
\begin_inset Formula $q_{n}$
\end_inset

 and where 
\begin_inset Formula $\eta$
\end_inset

 is the proportion of patches that are of density 
\begin_inset Formula $q_{n}$
\end_inset

.
 Note that 
\begin_inset Formula $N$
\end_inset

 in the numerator of the fraction is there to scale the number of migrants given the number of patches producing them,
 but that 
\begin_inset Formula $N$
\end_inset

 gets canceled out as these migrants are dispersed across these patches (see the denominator),
 telling us that the number of immigrants to a patch is not dependent on the number of patches;
 only the frequency distribution over patch states matters.
 The expected reproductive rate of an individual in a patch of population density 
\begin_inset Formula $q_{n}$
\end_inset

 is defined as 
\begin_inset Formula 
\begin{equation}
r(q_{n})=\sum^{S}_{s}\sum^{\Pi}_{\pi}\sum^{M}_{m}[\rho_{n}(s,\pi,m)\cdot R(s,m,n)]\label{eq:-5}
\end{equation}

\end_inset

where 
\begin_inset Formula $\rho_{n}(s,\pi,m)$
\end_inset

 is the probability that an individual will be of state 
\begin_inset Formula $\{s,\pi,m\}$
\end_inset

 given that they are in a patch of population density 
\begin_inset Formula $q_{n}$
\end_inset

,
 and 
\begin_inset Formula $R(s,m,n)$
\end_inset

 is the reproductive rate of an individual of state 
\begin_inset Formula $\{s,m\}$
\end_inset

 in a patch of density 
\begin_inset Formula $q_{n}$
\end_inset

 (see section 1.4).
 
\end_layout

\begin_layout Subsubsection
Death rates
\end_layout

\begin_layout Standard
Given the baseline rate of death 
\begin_inset Formula $\lambda$
\end_inset

 and deaths caused by lack of investment in maintenance,
 patches can transition to lower population density states.
 Therefore,
 given the posterior densities of individuals within patches,
 the posterior of population size of a patch of density state 
\begin_inset Formula $q_{o}$
\end_inset

 is 
\begin_inset Formula 
\begin{equation}
u(q_{o})=q_{o}\cdot(1-\lambda)\cdot\sum_{s}\sum_{\pi}\sum_{m}\hat{\rho_{o}}(s^{\prime},\pi^{\prime},m^{\prime})\label{eq:-26}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Demographic projection
\end_layout

\begin_layout Standard
The following function returns the posterior population size of a patch of prior density 
\begin_inset Formula $o$
\end_inset

,
 prior physiological state distribution 
\begin_inset Formula $\rho_{o}(s,\pi,m)$
\end_inset

,
 and resident strategy 
\begin_inset Formula $x(s,\pi,m)$
\end_inset

,
 given the above birth and death processes
\begin_inset Formula 
\begin{equation}
n(q_{o},\rho_{o},x)=u(q_{o})+\alpha(q_{o}).\label{eq:-27}
\end{equation}

\end_inset

This deterministic update of size then needs to be interpolated onto the grid of possible patch density states giving transition probabilities of a patch from state 
\begin_inset Formula $o$
\end_inset

 to 
\begin_inset Formula $n$
\end_inset

 given deaths from maintenance failures,
 defined by interpolating 
\begin_inset Formula $n(q_{o},\rho_{o},x)$
\end_inset

 thus for each 
\begin_inset Formula $o\in\{0,1\}$
\end_inset


\begin_inset Formula 
\begin{equation}
P_{\text{det}}(q_{1}|q_{o})=\frac{min(q_{1},max(q_{0},n(q_{o},\rho_{o},x)))-n_{low}}{n_{max}}\label{eq:-26-1}
\end{equation}

\end_inset

and then 
\begin_inset Formula 
\begin{equation}
P_{\text{det}}(q_{0}|q_{o})=1-P_{\text{det}}(q_{1}|q_{o})\label{eq:-28}
\end{equation}

\end_inset

We then wish to add some demographic stochasticity to this deaths and births process for which we use our model of density-dependent perturbations for each possible transition
\begin_inset Formula 
\begin{equation}
P(q_{n}|q_{o})=P_{stoch}(q_{n}|q_{1})\cdot P_{det}(q_{1}|q_{o})+P_{stoch}(q_{n}|q_{0})\cdot P_{det}(q_{0}|q_{o})\label{eq:-29}
\end{equation}

\end_inset

We can then calculate the posterior distribution of patch states
\begin_inset Formula 
\begin{equation}
\eta^{\prime}_{1}=\eta_{1}\cdot P(q_{1}|q_{1})+(1-\eta_{1})\cdot P(q_{1}|q_{0}),\label{eq:-23}
\end{equation}

\end_inset

and then the posterior probability distribution over individual states for patches of each population density state 
\begin_inset Formula 
\begin{equation}
\rho^{\prime}_{n}(s^{\prime},\pi^{\prime},m^{\prime})=\sum_{q_{o}}\frac{1}{\eta^{\prime}_{n}}\cdot\eta_{o}\cdot P(q_{n}|q_{o})\cdot[\frac{u(q_{o})}{u(q_{o})+\alpha(q_{o})}\cdot\frac{\hat{\rho_{o}}(s^{\prime},\pi^{\prime},m^{\prime})}{\sum_{s}\sum_{\pi}\sum_{m}\hat{\rho_{o}}(s^{\prime},\pi^{\prime},m^{\prime})}+\frac{\alpha(q_{o})}{u(q_{o})+\alpha(q_{o})}\cdot\tilde{\rho}(s,\pi,m)].\label{eq:-30-1}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Belief updating between growth cycles
\end_layout

\begin_layout Standard
The population evolves priors for the transition probabilities between growth cycles,
 and the distribution of states must again be updated
\begin_inset Formula 
\begin{equation}
\rho^{\prime\prime}_{n}(s^{\prime},\pi^{\prime\prime},m^{\prime})=\sum_{\pi^{\prime}}\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},\text{time})\cdot\rho^{\prime}_{n}(s^{\prime},\pi^{\prime},m^{\prime}).\label{eq:-48}
\end{equation}

\end_inset

where 
\begin_inset Formula $\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},\text{time})$
\end_inset

 is their belief state transition probabilities given their priors for the transition probabilities,
 
\begin_inset Formula $\tilde{P}(q_{1}|q_{0})$
\end_inset

,
 between patch density states between growth cycles.
 Note,
 however that in the first instance there will not yet be any evolutionary history for us to calculate these probabilities from and so we will assume that individuals assume patch states remain the same,
 giving a probability of belief state transition between cycles of 
\begin_inset Formula $\tilde{P}(\pi^{\prime\prime}=\pi^{\prime}|\pi^{\prime},t)=1.0$
\end_inset

.
 Otherwise,
 after their first iteration of adaptation,
 they will inherit priors for the transition probabilities between patch population density states at demographic stability given the developmental actions of the rest of the population,
 patch perturbations,
 and patch growth from dispersal,
 since their own previous development action (outlined in section 5.1).
 Regardless of what their priors are,
 to define 
\begin_inset Formula $\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},\text{time})$
\end_inset

 we first calculate from these priors their posterior belief state 
\begin_inset Formula 
\begin{equation}
\pi^{\prime\prime}=(1-\pi^{\prime})\cdot\tilde{P}(q_{1}|q_{0})+\pi^{\prime}\cdot\tilde{P}(q_{1}|q_{1})\label{eq:-1}
\end{equation}

\end_inset

which then has to be interpolated on the discrete belief state space as before,
 with the integer part defined by
\begin_inset Formula 
\begin{equation}
i=\lfloor\pi^{\prime\prime}\cdot I\rfloor,\label{eq:-33}
\end{equation}

\end_inset

and subsequently the fractional part defined as
\begin_inset Formula 
\begin{equation}
f=\pi^{\prime\prime}\cdot I-i.\label{eq:-34}
\end{equation}

\end_inset

We can then generate the transition probability matrix for belief states given that population growth and patch perturbations will have occurred within the time between developmental actions,
 i.e.
 
\begin_inset Formula $\tilde{P}(\pi^{\prime}|\pi,time)$
\end_inset

,
 defined by running the following algorithm for all prior belief states:
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\forall\pi^{\prime}$
\end_inset

,
 
\begin_inset Formula $\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},time)=0.0$
\end_inset

,
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\text{add \ensuremath{(1-f)} to }\tilde{P}(\pi^{\prime\prime}=i|\pi^{\prime},time)$
\end_inset

,
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\text{add \ensuremath{f} to }\tilde{P}(\pi^{\prime\prime}=i+1|\pi^{\prime},time)$
\end_inset

.
\end_layout

\begin_layout Subsection
Demographic Stability
\end_layout

\begin_layout Standard
Assuming that with successive generations 
\begin_inset Formula $n$
\end_inset

 that the distribution of patches over states converges on stable values,
 i.e.
 
\begin_inset Formula 
\begin{equation}
\ensuremath{\eta^{*}}=\text{lim}_{\rightarrow\infty}[\eta]\label{eq:-36}
\end{equation}

\end_inset

further,
 we can approximate 
\begin_inset Formula $\eta^{*}$
\end_inset

 by iterating over generations until 
\begin_inset Formula 
\begin{equation}
tol>|\eta-\eta^{\prime\prime}|\label{eq:-37}
\end{equation}

\end_inset

where the tolerance threshold,
 
\begin_inset Formula $tol$
\end_inset

,
 is very small,
 and 
\begin_inset Formula $\eta^{\prime\prime}$
\end_inset

 is the proportion of patches that are of population density state 
\begin_inset Formula $q_{1}$
\end_inset

 after dispersal and deaths.
 Once demographic stability is reached we assume 
\begin_inset Formula $\eta^{*}=\eta$
\end_inset

 and proceed with invasion analysis.
 Similarly we will assume that the transition probabilities between states will have reached stability too
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
P^{*}(q_{n}|q_{o})=\text{lim}_{\rightarrow\infty}[P(q_{n}|q_{o})].\label{eq:-30}
\end{equation}

\end_inset


\end_layout

\begin_layout Section
Invasion Analysis
\end_layout

\begin_layout Subsection
The Evolution of Priors
\end_layout

\begin_layout Standard
After demographic stability is reached,
 we assume invading individuals evolve accurate prior information regarding the probability distribution over the population density states of patches,
 and so the resident priors in the nest demographic projection will need to be updated,
 i.e.
\begin_inset Formula 
\begin{equation}
\tilde{\eta}=\eta^{*}\label{eq:-3-1}
\end{equation}

\end_inset

where as a reminder 
\begin_inset Formula $\eta^{*}$
\end_inset

 is the proportion of patches that are of population density 
\begin_inset Formula $q_{1}$
\end_inset

 at demographic stability.
 Therefore,
 the newborn physiology state distribution 
\begin_inset Formula $\tilde{\rho}(s,\pi,m)$
\end_inset

 must be updated,
 as per section 3.2,
 wherein 
\begin_inset Formula $\tilde{\eta}$
\end_inset

 is interpolated onto the grid of belief states and used as the prior for newborns.
 Individuals also evolve accurate priors for the transition probabilities between patch population density states at demographic stability given the developmental actions of the rest of the population,
 patch perturbations,
 and patch growth from dispersal,
 since their own previous development action
\begin_inset Formula 
\begin{equation}
\tilde{P}(q_{n}|q_{o})=P^{*}(q_{n}|q_{o}),\label{eq:-31}
\end{equation}

\end_inset

and subsequently 
\begin_inset Formula $\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},time)$
\end_inset

 must be updated again prior to proceeding with our invasion analysis,
 with invaders using the updated 
\begin_inset Formula $\tilde{P}(q_{n}|q_{o})$
\end_inset

 to update their belief states as in section 4.4,
 generating posterior belief
\begin_inset Formula 
\begin{equation}
\pi^{\prime\prime}=(1-\pi^{\prime})\cdot\tilde{P}(q_{1}|q_{0})+\pi^{\prime}\cdot\tilde{P}(q_{1}|q_{1})\label{eq:-1-2}
\end{equation}

\end_inset

which then has to be interpolated on the discrete belief state space as before,
 with the integer part defined by
\begin_inset Formula 
\begin{equation}
i=\lfloor\pi^{\prime\prime}\cdot I\rfloor,\label{eq:-33-1}
\end{equation}

\end_inset

and subsequently the fractional part defined as
\begin_inset Formula 
\begin{equation}
f=\pi^{\prime\prime}\cdot I-i.\label{eq:-34-1}
\end{equation}

\end_inset

We can then generate the transition probability matrix for belief states given that population growth and patch perturbations will have occurred within the time between developmental actions,
 i.e.
 
\begin_inset Formula $P(\pi^{\prime}|\pi,time)$
\end_inset

,
 defined by running the following algorithm for all prior belief states:
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\forall\pi^{\prime}$
\end_inset

,
 
\begin_inset Formula $\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},time)=0.0$
\end_inset

,
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\text{add \ensuremath{(1-f)} to }\tilde{P}(\pi^{\prime\prime}=i|\pi^{\prime},time)$
\end_inset

,
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\text{add \ensuremath{f} to }\tilde{P}(\pi^{\prime\prime}=i+1|\pi^{\prime},time)$
\end_inset

.
\end_layout

\begin_layout Subsection
The Best Response Strategy
\end_layout

\begin_layout Standard
Having found the demographically stable state of the metapopulation,
 given the resident strategy,
 and having evolved accurate priors,
 we can then use the Bellman equation to find the best response developmental strategy 
\begin_inset Formula $b(x(s,\pi^{\prime},m))$
\end_inset

 for an invading individual.
 We define a Bellman fitness equation for individuals in the model where 
\begin_inset Formula $V(s,\pi,m)=0$
\end_inset

 for all state combinations (as the individual is dead),
 and iterate backwards to the previous time step
\begin_inset Formula 
\begin{equation}
V^{\prime}(s,\pi,m)=R(s,m)+\sum_{g}\sum_{\pi^{\prime}}P(g|\pi)\cdot P(\pi^{\prime}|\pi,g)\cdot P_{pert}(survival|\pi^{\prime})\cdot\text{max}_{\kappa}[\sum_{s^{\prime}}\sum_{\pi^{\prime\prime}}\sum_{m^{\prime}}V(s^{\prime},\pi^{\prime\prime},m^{\prime})\cdot\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},time)\cdot P(s^{\prime},m^{\prime},\text{survives}|x(s,\pi^{\prime},m)=\kappa,s,m,\pi^{\prime},g)],\label{eq:-39-1}
\end{equation}

\end_inset

where 
\begin_inset Formula $\kappa\in\{0,1,...,G-1,G\}$
\end_inset

 representing each possible state-dependent developmental action for comparison,
 and where 
\begin_inset Formula $R(s,m)$
\end_inset

 is the rate of reproduction for an individual of size 
\begin_inset Formula $s$
\end_inset

 and quality 
\begin_inset Formula $m$
\end_inset

 (see equation 1),
 and where 
\begin_inset Formula $P_{pert}(survival|\pi^{\prime})$
\end_inset

 is the probability of death from patch depletion and a probability of death 
\begin_inset Formula $\lambda$
\end_inset

 from exogenous factors (e.g.
 old age) and where 
\begin_inset Formula $p(s^{\prime},m^{\prime},\text{survives}|\kappa,s,m,\pi^{\prime\prime},g)$
\end_inset

 is the probability of survival to a posterior size 
\begin_inset Formula $s^{\prime}$
\end_inset

 and quality 
\begin_inset Formula $m^{\prime}$
\end_inset

 given the individual's developmental policy dependent on their current size,
 quality,
 and information states,
 given the food mass they received,
 and given their probability of survival given maintenance costs.
 
\end_layout

\begin_layout Standard
With successive iterations the 
\begin_inset Formula $V(s,\pi,m)$
\end_inset

 converges to a stable value for each state
\begin_inset Formula 
\[
V^{*}(s,\pi,m)=\text{lim}_{\rightarrow\infty}[V(s,\pi,m)]
\]

\end_inset

but again we can approximate 
\begin_inset Formula $V^{*}(s,\pi,m)$
\end_inset

 by assuming sufficient convergence has occurred when
\begin_inset Formula 
\[
tol>|V^{\prime}(s,\pi,m)-V(s,\pi,m)|
\]

\end_inset

where tol is a small number (e.g.
 
\begin_inset Formula $\text{tol}=0.001$
\end_inset

),
 at which point we can define the best response.
\end_layout

\begin_layout Standard
Only the expressions within the max function matter for what developmental policy evolves and so the best response is
\begin_inset Formula 
\[
b(x(s,\pi^{\prime},m))=\text{argmax}_{\kappa}[\sum_{s^{\prime}}\sum_{\pi^{\prime\prime}}\sum_{m^{\prime}}V^{*}(s^{\prime},\pi^{\prime\prime},m^{\prime})\cdot\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},time)\cdot P(s^{\prime},m^{\prime},\text{survives}|x(s,\pi^{\prime},m)=\kappa,s,m,\pi^{\prime},g)].
\]

\end_inset

Note that the influence of the resident strategy on the best response derives ultimately from 
\begin_inset Formula $\tilde{P}(\pi^{\prime\prime}|\pi^{\prime},time)$
\end_inset

,
 which represents an individual's perception of the underlying transition probabilities between patch population density states at demographic stability,
 
\begin_inset Formula $\tilde{P}(q_{n}|o_{n})$
\end_inset

,
 which emerges from the strategy dependent birth and death rates of the resident population and the probability distribution over patch densities 
\begin_inset Formula $\eta^{*}$
\end_inset

,
 determinging the growth rate of the metapopulation.
 Meanwhile,
 
\begin_inset Formula $P(s^{\prime},m^{\prime},\text{survives}|x(s,\pi^{\prime},m)=\kappa,s,m,\pi^{\prime},g)$
\end_inset

 represents our mechanistic assumptions about how our developmental strategy influences an individual's future size,
 mass,
 and survival;
 and 
\begin_inset Formula $V(s^{\prime},\pi^{\prime\prime},m^{\prime})$
\end_inset

 is simply the expected fitness benefit of the resulting posterior physiological state given the broader model structure and assuming optimal behaviour at all future time steps.
\end_layout

\begin_layout Subsection
The Evolutionarily Stable Strategy
\end_layout

\begin_layout Standard
We then assume the best response strategy becomes the new resident strategy,
 and recalculate the demographically stable state of the metapopulation,
 and can continue to iterate like this until we find an evolutionarily stable strategy (ESS).
 An ESS is a resident strategy for which invading individuals can do no better than to follow the resident strategy and so the ESS is defined as any strategy 
\begin_inset Formula $x^{*}(s,\pi^{\prime},m)$
\end_inset

 that satisfies
\begin_inset Formula 
\begin{equation}
b^{*}(x^{*}(s,\pi^{\prime},m))=x^{*}(s,\pi^{\prime},m).\label{eq:-38-1}
\end{equation}

\end_inset

If there is a singular ESS (as is usually the case),
 we can iterating over invasions till the best response strategy converges on the ESS,
 and the starting point of the population will not matter.
 By sampling from multiple starting points we can test this assumption,
 and if necessary plot out the adaptive dynamics with phase portraits where there are multiple ESSs or oscillatory dynamics.
\end_layout

\begin_layout Section
Life history Analysis
\end_layout

\begin_layout Standard
Now that we have found the state-dependent evolutionarily stable strategy for a given set of parameter values,
 along with the associated demographically stable distribution of individual physiological states and patch density states,
 we can ask what the ESS behaviour of a cohort of individuals within such a population would look like.
 We can assume that one small cohort following the same ESS will not have an influence on the distribution of states of the larger population and so we do not need to update any of the transition probabilities.
 
\end_layout

\begin_layout Subsection
Life history projection at stability
\end_layout

\begin_layout Standard
We know that they will begin life at the minimum size and quality states and with their belief state being the evolved prior for the stable patch distribution prior to dispersal,
 
\begin_inset Formula $\eta^{*}_{1}$
\end_inset

.
 Where 
\begin_inset Formula $\eta^{*}_{1}$
\end_inset

 is the proportion of patches prior to dispersal that are of density state 
\begin_inset Formula $n=1$
\end_inset

,
 and 
\begin_inset Formula $\eta^{*}_{0}=1-\eta^{*}_{1}$
\end_inset

 is the proportion of patches that are of density state 
\begin_inset Formula $n=0$
\end_inset

.
 So we assume of our cohort,
 the numbers of individuals that start at the state distribution of newborns and in each patch state are
\begin_inset Formula 
\[
\rho_{0,t}(s,\pi,m)=\tilde{\rho}(s,\pi,m)\cdot(1-\eta^{*})\cdot N\cdot q_{0},
\]

\end_inset


\begin_inset Formula 
\[
\rho_{1,t}(s,\pi,m)=\tilde{\rho}(s,\pi,m)\cdot(\eta^{*})\cdot N\cdot q_{1},
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $N$
\end_inset

 is some large number representing a plausible number of foraging patches within a metapopulation,
 and where as a reminder 
\begin_inset Formula $\tilde{\rho}(s,\pi,m)$
\end_inset

 is the physiological state distribution of newborns.
 Very conveniently we already know the transition probabilities for individuals using the ESS strategy 
\begin_inset Formula $\bar{x}(s,\pi,m)$
\end_inset

,
 and the system is both at demographic and evolutionary stability;
 making demographic projection at this stage exceedingly simple:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\hat{\rho_{n}}(s^{\prime},\pi^{\prime},m^{\prime})=\sum_{g}\sum_{s}\sum_{\pi}\sum_{m}P(s^{\prime},m^{\prime}|s,\pi^{\prime},m,g)\cdot P(survival|g,s,\pi^{\prime},m)\cdot P(\pi^{\prime}|\pi,g)\cdot L(g|q_{n})\cdot\rho_{n,t}(s,\pi,m).\label{eq:-17-2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Normally at this state we would then account for the addition of arrivals to the population from reproduction and dispersal but as we are only tracking the one cohort we can ignore things like 
\begin_inset Formula $\frac{\alpha(q_{o})}{u(q_{o})+\alpha(q_{o})}\cdot\tilde{\rho}(s,\pi,m)$
\end_inset

,
 and because 
\begin_inset Formula $\eta^{*}$
\end_inset

is fixed and as we are interested in the proportion that are alive we can ignore the normalisation step entirely giving us
\begin_inset Formula 
\begin{equation}
\rho^{\prime}_{n}(s^{\prime},\pi^{\prime},m^{\prime})=\sum_{q_{o}}\frac{1}{\eta^{\prime}_{n}}\cdot\eta_{o}\cdot P_{lab}(q_{n}|q_{o},t)\cdot\hat{\rho_{o}}(s^{\prime},\pi^{\prime},m^{\prime}).\label{eq:-30-1-1-1}
\end{equation}

\end_inset

Finally,
 we apply the time dependent updating of their belief state and generating the distribution of states in the next time step
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho_{n,t+1}(s^{\prime},\pi^{\prime\prime},m^{\prime})=\sum_{\pi^{\prime}}P(\pi^{\prime\prime}|\pi^{\prime},\text{time})\cdot\rho^{\prime}_{n}(s^{\prime},\pi^{\prime},m^{\prime}),\label{eq:-48-1}
\end{equation}

\end_inset

which we can then print for visualistion before iterating further;
 until 
\begin_inset Formula 
\[
1>N\cdot\sum_{\{s,\pi,m\}}\rho_{0,t}(s,\pi,m)+\rho_{1,t}(s,\pi,m),
\]

\end_inset

at which point we can be quite sure that most individuals of our cohort are dead,
 giving us a complete picture of their life history.
\end_layout

\begin_layout Subsection
Vital Rates
\end_layout

\begin_layout Standard
We will then know the rates at which individuals will be of each state and perform each action over the course of their life,
 and their age demographics.
 Crucially,
 we can weight actions within the ESS developmental strategy 
\begin_inset Formula $x^{*}(s,\pi,m)$
\end_inset

 by the proportion of individuals who are of that state at each time step.
 Of particular interest is at what age they begin to decide whether or not to invest in quality given their state distribution at that age.
 Alternatively,
 you can simply plot the proportion of individuals in the cohort who are of each quality state against time,
 or the vector space with arrows,
 and compare these for low belief,
 uncertain,
 and high belief state individuals.
\end_layout

